  if (CONFIG.supabaseKey.startsWith('eyJ')) h.Authorization = 'Bearer ' + CONFIG.supabaseKey;
  return h;
}
async function rpc(fn, args) {
  let res;
  try {
    res = await fetch(BASE + '/rest/v1/rpc/' + fn, { method: 'POST', headers: authHeaders({ 'Content-Type': 'application/json' }), body: JSON.stringify(args) });
  } catch (e) { throw new Error("Couldn't reach Bash. Check your connection and try again."); }
  const text = await res.text();
  let body = null;
  try { body = text ? JSON.parse(text) : null; } catch (e) { body = null; }
  if (!res.ok) throw new Error((body && body.message) || 'Something went wrong (error ' + res.status + '). Try again.');
  return body;
}
