          ${it.id ? '<button class="btn ghost sm" type="button" data-act="cancel-edit">Cancel</button>' : ''}
        </div>
      </form>`;
  }

  function giftRow(it) {
    if (S.editItem === it.id) return `<li class="gift"><div class="gift-main">${itemForm(it)}</div></li>`;
    const url = safeUrl(it.url);
    const chips = S.r.contributions.filter(c => c.item_id === it.id);
    let status = '';
    if (it.group_gift) {
      status = `${meterHtml(it.funded, it.price)}
        <p class="fundline"><span class="tag group">Chip-in gift</span> <strong>${inr(it.funded)}</strong> of ${inr(it.price)} from ${people(it.chippers)}</p>
        ${chips.length ? `<ul class="chip-list">${chips.map(c => `<li><span><strong>${esc(c.name)}</strong>${c.message ? ` — “${esc(c.message)}”` : ''}</span><span>${inr(c.amount)}</span></li>`).join('')}</ul>` : ''}`;
    } else if (it.claimed) {
      status = S.reveal
        ? `<p class="claimline"><span class="tag yours">Claimed</span><strong>${esc(it.claimed_by)}</strong>${it.claim_note ? ` — “${esc(it.claim_note)}”` : ''}</p>`
        : '<p class="claimline"><span class="tag yours">Claimed</span></p>';
    }
    return `
      <li class="gift">
        <div class="gift-top">
          ${it.image_url ? `<img class="thumb" src="${esc(it.image_url)}" alt="" loading="lazy">` : ''}
          <div class="gift-main">
            <div class="gift-name">${esc(it.name)}</div>
            <div class="gift-meta">${it.price ? `<span class="price">${inr(it.price)}</span>` : ''}${url ? `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer">${esc(domain(url))}</a>` : ''}</div>
            ${it.note ? `<p class="gift-note">${esc(it.note)}</p>` : ''}
            ${status}
          </div>
        </div>
        <div class="gift-side gift-actions">
          <button class="link" data-act="edit-item" data-id="${esc(it.id)}">Edit</button>
          ${it.claimed ? `<button class="link" data-act="release" data-id="${esc(it.id)}">Free up</button>` : ''}
          <button class="link danger" data-act="del-item" data-id="${esc(it.id)}">Remove</button>
        </div>
      </li>`;
  }

  function render() {
    const r = S.r;
    document.title = r.title + ' · Manage';
    const link = guestUrl(r.slug);
    const normal = r.items.filter(i => !i.group_gift);
    const claimed = normal.filter(i => i.claimed).length;
    const waText = `${occ(r.occasion).emoji} ${r.title}\nHere's my gift list — pick something and it gets marked as taken so nobody doubles up:\n${link}`;
    const shagun = r.contributions.filter(c => !c.item_id);

    app.innerHTML = `
      <a class="back" href="#/">‹ All my Bashes</a>
      ${S.pay === 'confirming' ? `<div class="banner" role="status"><h3>Confirming your payment…</h3><p class="muted" style="margin:0">This usually takes a few seconds. Plus features unlock on this page automatically.</p></div>` : ''}
      ${S.pay === 'slow' ? `<div class="banner" role="status"><h3>Still confirming</h3><p class="muted" style="margin:0">Your payment is taking longer than usual to confirm. Refresh this page in a minute. If you were charged and Plus doesn't unlock, reply to your payment receipt email.</p></div>` : ''}
      ${S.pay === 'failed' ? `<div class="banner" role="alert"><h3>Payment didn't go through</h3><p class="muted" style="margin:0">You weren't upgraded. You can try again whenever you like.</p></div>` : ''}
      ${S.pay === 'done' ? `<div class="banner"><h3>Bash Plus unlocked 🎉</h3><p class="muted" style="margin:0">You can now add gift photos, set up chip-in gifts, and get email alerts.</p></div>` : ''}
      ${S.fresh ? `<div class="banner"><h3>Your Bash is live 🎉</h3><p class="muted" style="margin:0">Add a few gifts below, then send the link. ${r.host_email ? "We've emailed you your edit link too." : "Bookmark this page — it's how you edit your Bash."}</p></div>` : ''}
      <div class="page-head">
        <span class="emo" aria-hidden="true">${occ(r.occasion).emoji}</span>
        <h1 style="margin-top:8px">${esc(r.title)}</h1>
        ${r.plus ? '<span class="pill" style="margin-top:10px">Bash Plus ✓</span>' : ''}
        <div class="btn-row" style="margin-top:10px">
          <button class="link" data-act="toggle-details">${S.editDetails ? 'Close details' : 'Edit details'}</button>
          <a class="link" href="#/r/${enc(r.slug)}">See what guests see</a>
        </div>
      </div>

      ${S.editDetails ? `
      <section class="section panel" style="margin-top:20px">
        <form data-form="details" novalidate>
          ${detailsFields(r)}
          <div class="btn-row" style="margin-top:20px"><button class="btn sm" type="submit">Save details</button><button class="btn ghost sm" type="button" data-act="toggle-details">Cancel</button></div>
        </form>
      </section>` : (!r.host_email ? `
      <div class="note-box"><strong>Add your email</strong>Get a ping when gifts are reserved or cash comes in, and a way back in if you lose this page. <button class="link" data-act="toggle-details">Add email</button></div>` : '')}

      <section class="section">
        <h2 class="h2">Share with guests</h2>
        <div class="share-link">
          <input type="text" readonly value="${esc(link)}" aria-label="Guest link">
          <button class="btn ghost sm" data-act="copy" data-text="${esc(link)}">Copy</button>
        </div>
        <div class="btn-row">
          <a class="btn wa sm" href="https://wa.me/?text=${enc(waText)}" target="_blank" rel="noopener noreferrer">Send on WhatsApp</a>
          ${navigator.share ? '<button class="btn ghost sm" data-act="native-share">More ways to share</button>' : ''}
        </div>
        <div class="note-box"><strong>Your private edit link</strong>Anyone with this link can change your Bash, so keep it to yourself. <button class="link" data-act="copy" data-text="${esc(manageUrl(r.slug, tok))}">Copy edit link</button></div>
      </section>

      ${r.plus ? '' : `
      <section class="section" id="plus-sec">
        <div class="panel plus-card">
          <span class="pill">Bash Plus</span>
          <h3 style="font-size:1.35rem;margin:12px 0 6px">Make this Bash extra, for ${inr(PLUS_PRICE)}</h3>
          <ul class="plus-list">
            <li>Photos on every gift, so the list looks the part</li>
            <li>Chip-in gifts, so friends can club together on something big</li>
            <li>Email alerts when gifts are reserved or cash comes in</li>
          </ul>
          <button class="btn" data-act="upgrade">Upgrade for ${inr(PLUS_PRICE)}</button>
          <p class="muted small" style="margin:10px 0 0">One-time payment for this Bash. Pay by UPI or card, handled securely by Dodo Payments.</p>
        </div>
      </section>`}

      <section class="section">
        <div class="section-head">
          <div><h2 class="h2">Gifts</h2><p class="muted small" style="margin:0">${r.items.length ? (normal.length ? `${claimed} of ${normal.length} claimed` : `${r.items.length} chip-in ${r.items.length === 1 ? 'gift' : 'gifts'}`) : 'Nothing here yet'}</p></div>
          ${claimed ? `<button class="link" data-act="reveal">${S.reveal ? "Hide who's getting what" : "Show who's getting what"}</button>` : ''}
        </div>
        ${r.items.length ? `<ul class="gifts">${r.items.map(giftRow).join('')}</ul>` : ''}
        <div class="panel" style="margin-top:14px">
          <h3 style="font-size:1.1rem;margin-bottom:12px">Add a gift</h3>
          ${itemForm({})}
        </div>
      </section>

      ${r.fund_enabled ? `
      <section class="section">
        <h2 class="h2">Shagun fund</h2>
        <p class="muted small" style="margin:0">Guests pay ${esc(r.upi_id)} directly and tell you here. Check your UPI app to confirm it arrived.</p>
        <div class="meter">
          ${r.fund_goal ? `<div class="meter-bar"><div class="meter-fill" style="width:${Math.min(100, r.raised / r.fund_goal * 100)}%"></div></div>` : ''}
          <div class="meter-label"><span><strong>${inr(r.raised)}</strong> from ${people(r.contributors)}</span>${r.fund_goal ? `<span class="muted">Goal ${inr(r.fund_goal)}</span>` : ''}</div>
        </div>
        ${shagun.length ? `<ul class="contribs">${shagun.map(c => `
          <li><div><strong>${esc(c.name)}</strong>${c.message ? `<div class="muted small">“${esc(c.message)}”</div>` : ''}</div><span class="amt-v">${inr(c.amount)}</span></li>`).join('')}</ul>`
          : '<p class="muted small">No shagun yet. It shows up here as guests send it.</p>'}
      </section>` : ''}

      <section class="danger-zone">
        <button class="link danger" data-act="delete-bash">Delete this Bash</button>
        <p class="muted small" style="margin:4px 0 0">Removes the page, gifts and all records for good. Guests' links will stop working.</p>
      </section>`;
  }

  H['goto-plus'] = () => { const el = document.getElementById('plus-sec'); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
  H['upgrade'] = async el => {
    busy(el, true, 'Opening payment…');
    try {
      const res = await api.startUpgrade(slug, tok);
      if (res.already) { toast('This Bash already has Plus'); busy(el, false); return refresh(); }
      location.href = res.checkout_url;
    } catch (e) { busy(el, false); toast(e.message); }
  };
  H['toggle-details'] = () => { S.editDetails = !S.editDetails; render(); if (S.editDetails) app.querySelector('form[data-form="details"]').scrollIntoView({ block: 'start' }); };
  H['reveal'] = () => { S.reveal = !S.reveal; render(); };
  H['copy'] = el => copyText(el.dataset.text);
  H['native-share'] = () => navigator.share({ title: S.r.title, text: S.r.title + ' — gift list', url: guestUrl(S.r.slug) }).catch(() => {});
  H['edit-item'] = el => { S.editItem = el.dataset.id; delete S.photo[el.dataset.id]; render(); };
  H['cancel-edit'] = () => { delete S.photo[S.editItem]; S.editItem = null; render(); };
  H['change:fund_enabled'] = fundToggle;
  H['change:photo'] = async el => {
    const key = el.dataset.key, file = el.files && el.files[0];
    if (!file) return;
    const form = el.closest('form');
    const ph = form.querySelector('.ph');
    ph.textContent = '…';
    const submit = form.querySelector('[type=submit]');
    submit.disabled = true;
    try {
      S.photo[key] = await uploadPhoto(file);
      ph.innerHTML = `<img src="${esc(S.photo[key])}" alt="">`;
      el.closest('.file-btn').firstChild.textContent = 'Change photo';
      if (!form.querySelector('[data-act="photo-remove"]')) {
        el.closest('.btn-row').insertAdjacentHTML('beforeend', `<button class="link" type="button" data-act="photo-remove" data-key="${esc(key)}">Remove</button>`);
      }
    } catch (e) {
      ph.innerHTML = S.photo[key] ? `<img src="${esc(S.photo[key])}" alt="">` : '📷';
      toast(e.message);
    }
    submit.disabled = false;
    el.value = '';
  };
  H['photo-remove'] = el => {
    const key = el.dataset.key;
    S.photo[key] = '';
    const form = el.closest('form');
    form.querySelector('.ph').textContent = '📷';
    form.querySelector('.file-btn').firstChild.textContent = 'Add photo';
    el.remove();
  };
  H['del-item'] = async el => {
    const it = S.r.items.find(i => i.id === el.dataset.id);
    if (!it) return;
    const warn = it.claimed ? `Someone has already claimed “${it.name}”. Remove it anyway?`
      : it.chippers ? `${people(it.chippers)} already chipped in for “${it.name}”. Remove it and those records?` : `Remove “${it.name}”?`;
    if (!confirm(warn)) return;
    try { await api.deleteItem(slug, tok, it.id); toast('Gift removed'); } catch (e) { toast(e.message); }
    refresh();
  };
  H['release'] = async el => {
    const it = S.r.items.find(i => i.id === el.dataset.id);
    if (!it || !confirm(`Free up “${it.name}” so another guest can pick it?`)) return;
    try { await api.releaseItem(slug, tok, it.id); toast('Gift is available again'); } catch (e) { toast(e.message); }
    refresh();
  };
  H['delete-bash'] = async el => {
    if (!confirm(`Delete “${S.r.title}” for good? The guest page, gifts and every record go with it. This can't be undone.`)) return;
    busy(el, true, 'Deleting…');
    try {
      await api.deleteRegistry(slug, tok);
      forgetBash(slug);
      toast('Bash deleted');
      location.hash = '#/';
    } catch (e) { busy(el, false); toast(e.message); }
  };
  H['submit:details'] = async (form, btn) => {
    const { data, error } = readDetails(form);
    if (error) return showError(form, error);
    busy(btn, true);
    try { await api.updateRegistry(slug, tok, data); S.editDetails = false; toast('Details saved'); await refresh(); }
    catch (e) { busy(btn, false); showError(form, e.message); }
  };
  H['submit:item'] = async (form, btn) => {
    const f = new FormData(form);
    const key = form.dataset.key;
    const existing = S.r.items.find(i => i.id === key);
    const item = {
      id: String(f.get('id') || '') || null,
      name: String(f.get('name') || '').trim(),
      price: f.get('price') ? Math.round(Number(f.get('price'))) : null,
      url: String(f.get('url') || '').trim(),
      note: String(f.get('note') || '').trim(),
      image_url: S.photo[key] !== undefined ? S.photo[key] : ((existing && existing.image_url) || ''),
      group_gift: !!f.get('group_gift')
    };
    if (!item.name) return showError(form, 'Give the gift a name.');
    if (item.url && !safeUrl(item.url)) return showError(form, 'Links need to start with https://');
    if (item.price !== null && !(item.price > 0)) return showError(form, 'Price needs to be a number above zero, or leave it blank.');
    if (item.group_gift && !item.price) return showError(form, 'Add a price so guests know how much to chip in toward.');
    busy(btn, true);
    try {
      await api.saveItem(slug, tok, item);
      toast(item.id ? 'Gift saved' : 'Gift added');
      delete S.photo[key];
      S.editItem = null; S.fresh = false;
      await refresh();
      if (!item.id) { const inp = app.querySelector('.panel form[data-form="item"] input[name="name"]'); if (inp) inp.focus(); }
    } catch (e) { busy(btn, false); showError(form, e.message); }
  };

  render();

  if (S.pay === 'confirming') {
    if (S.r.plus) { S.pay = 'done'; render(); return; }
    let tries = 0;
    const timer = setInterval(async () => {
      tries++;
      if (!document.body.contains(app) || location.hash.indexOf('#/m/' + enc(slug)) !== 0) return clearInterval(timer);
      try { await load(); } catch (e) { /* keep trying */ }
      if (S.r.plus) { clearInterval(timer); S.pay = 'done'; toast('Bash Plus unlocked 🎉'); render(); }
      else if (tries >= 20) { clearInterval(timer); S.pay = 'slow'; render(); }
    }, 2500);
  }
}

/* ---------- guest ---------- */
async function viewGuest(slug) {
  loading();
  const S = { r: null, claiming: null, chipping: null, pays: {} };
  async function load() { S.r = await api.getRegistry(slug, null); }
  try { await load(); } catch (e) { return viewMessage("Couldn't load this Bash", e.message); }
  if (!S.r) return viewMessage("We couldn't find this Bash", 'Check the link with whoever sent it — part of it may be missing, or the host may have deleted it.');

  const claims = () => store.get(KEY_CLAIMS, {});
  const itemById = id => S.r.items.find(i => i.id === id);
  async function refresh() { try { await load(); } catch (e) { toast(e.message); } renderGifts(); renderFund(); }

  function chipOptions(it) {
    const left = Math.max(0, (it.price || 0) - it.funded);
    const chips = [500, 1000, 2000, 5000].filter(v => v < left).slice(0, 3).map(v => ({ v, label: inr(v) }));
    if (left > 0) chips.push({ v: left, label: 'The rest · ' + inr(left) });
    return chips;
  }
  function payState(key) {
    if (!S.pays[key]) {
      const it = key === 'fund' ? null : itemById(key);
      const first = it ? (chipOptions(it)[0] || { v: 500 }).v : 1100;
      S.pays[key] = { step: 'form', amount: first, custom: false, name: store.get(KEY_NAME, ''), message: '' };
    }
    return S.pays[key];
  }
  const rerender = key => key === 'fund' ? renderFund() : renderGifts();

  function giftRow(it) {
    const mine = !!claims()[it.id];
    const url = safeUrl(it.url);
    const thumb = it.image_url ? `<img class="thumb" src="${esc(it.image_url)}" alt="" loading="lazy">` : '';
    let side = '', extra = '', cls = '';

    if (it.group_gift) {
      const full = it.price && it.funded >= it.price;
      extra = `${meterHtml(it.funded, it.price)}
        <p class="fundline"><strong>${inr(it.funded)}</strong> of ${inr(it.price)} chipped in${it.chippers ? ` by ${people(it.chippers)}` : ''}</p>`;
      if (S.chipping === it.id) {
        extra += `<div class="inline-form">${payBlock(it.id, payState(it.id), S.r, {
          chips: chipOptions(it), msgLabel: `A note for ${esc(S.r.host_name)}`, upiNote: 'Gift: ' + it.name,
          doneWhat: 'you chipped in', againLabel: 'Close', cancel: true })}</div>`;
      } else if (full) side = '<span class="tag done">Fully funded 🎉</span>';
      else side = `<button class="btn sm" data-act="chip-open" data-id="${esc(it.id)}">Chip in</button>`;
    } else if (mine) {
      cls = 'mine-claim';
      side = `<span class="tag yours">You're getting this</span><button class="link" data-act="unclaim" data-id="${esc(it.id)}">Undo</button>`;
    } else if (it.claimed) {
      cls = 'taken';
      side = '<span class="tag">Taken</span>';
    } else if (S.claiming === it.id) {
      extra = `
        <form data-form="claim" class="inline-form" novalidate>
          <input type="hidden" name="id" value="${esc(it.id)}">
          <label class="field"><span>Your name</span><input type="text" name="name" maxlength="60" autocomplete="name" value="${esc(store.get(KEY_NAME, ''))}" placeholder="So ${esc(S.r.host_name)} knows who to thank"></label>
          <label class="field"><span>A note for ${esc(S.r.host_name)} <em class="opt">optional</em></span><input type="text" name="note" maxlength="280" placeholder="Only shown if they choose to peek"></label>
          <div class="btn-row"><button class="btn sm" type="submit">Reserve it</button><button class="btn ghost sm" type="button" data-act="claim-cancel">Cancel</button></div>
        </form>`;
    } else {
      side = `<button class="btn sm" data-act="claim-open" data-id="${esc(it.id)}">I'll get this</button>`;
    }
    const showDetails = !it.claimed || mine;
    return `
      <li class="gift ${cls}">
        <div class="gift-top">
          ${thumb}
          <div class="gift-main">
            <div class="gift-name">${esc(it.name)}</div>
            <div class="gift-meta">${it.price ? `<span class="price">${inr(it.price)}</span>` : ''}${url && showDetails ? `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer">${mine ? 'Buy it on ' : 'See it on '}${esc(domain(url))}</a>` : ''}</div>
            ${it.note && showDetails ? `<p class="gift-note">${esc(it.note)}</p>` : ''}
            ${extra}
          </div>
        </div>
        ${side ? `<div class="gift-side">${side}</div>` : ''}
      </li>`;
  }

  function renderGifts() {
    const el = document.getElementById('gifts-sec');
    if (!el) return;
    const items = S.r.items;
    if (!items.length) { el.innerHTML = S.r.fund_enabled ? '' : '<div class="panel empty">Nothing on the list yet. Check back soon.</div>'; return; }
    const normal = items.filter(i => !i.group_gift);
    const open = normal.filter(i => !i.claimed).length;
    el.innerHTML = `
      <div class="section-head"><div><h2 class="h2">Gift list</h2><p class="muted small" style="margin:0">${normal.length ? `Reserve something and it's marked as taken, so nobody doubles up. ${open} of ${normal.length} still up for grabs.` : 'Chip in together on something bigger.'}</p></div></div>
      <ul class="gifts">${items.map(giftRow).join('')}</ul>`;
  }

  function renderFund() {
    const el = document.getElementById('fund-sec');
    if (!el) return;
    const r = S.r;
    if (!r.fund_enabled || !r.upi_id) { el.innerHTML = ''; return; }
    const meter = (r.fund_goal || r.contributors) ? `
      <div class="meter">
        ${r.fund_goal ? `<div class="meter-bar" role="progressbar" aria-valuemin="0" aria-valuemax="${r.fund_goal}" aria-valuenow="${r.raised}"><div class="meter-fill" style="width:${Math.min(100, r.raised / r.fund_goal * 100)}%"></div></div>` : ''}
        <div class="meter-label">${r.contributors ? `<span><strong>${inr(r.raised)}</strong> from ${people(r.contributors)}</span>` : '<span>Be the first to send shagun</span>'}${r.fund_goal ? `<span class="muted">Goal ${inr(r.fund_goal)}</span>` : ''}</div>
      </div>` : '';
    el.innerHTML = `
      <h2 class="h2">Shagun fund</h2>
      <p class="muted small" style="margin:0">Rather send cash? Pick an amount and pay by UPI.</p>
      ${meter}
      <div class="panel" style="margin-top:14px">${payBlock('fund', payState('fund'), r, {
        chips: SHAGUN.map(v => ({ v, label: inr(v) })), msgLabel: 'Blessings or a message', upiNote: 'Shagun: ' + r.title,
        doneWhat: 'your shagun and message', againLabel: 'Send more', cancel: false })}</div>`;
  }

  function render() {
    const r = S.r;
    const dt = dateInfo(r.event_date);
    const tok = myTokenFor(r.slug);
    document.title = r.title + ' · Bash';
    app.innerHTML = `
      ${tok ? `<div class="owner-bar"><span>This is your Bash. This is what guests see.</span><a class="link" href="#/m/${enc(r.slug)}/${enc(tok)}">Back to editing</a></div>` : ''}
      <section class="invite">
        <span class="emo-big" aria-hidden="true">${occ(r.occasion).emoji}</span>
        <h1>${esc(r.title)}</h1>
        <p class="host">Hosted by <strong>${esc(r.host_name)}</strong></p>
        ${dt ? `<div class="when"><span class="pill soft">${esc(dt.pretty)}</span>${dt.rel ? `<span class="pill">${esc(dt.rel)}</span>` : ''}</div>` : ''}
        ${r.message ? `<blockquote class="letter" style="margin-left:0;margin-right:0">${esc(r.message)}<cite>— ${esc(r.host_name)}</cite></blockquote>` : ''}
      </section>
      <section class="section" id="gifts-sec"></section>
      <section class="section" id="fund-sec"></section>
      <div class="cta-own"><p>Got your own occasion coming up?</p><a class="btn ghost" href="#/new">Start your own Bash</a></div>`;
    renderGifts(); renderFund();
  }

  /* reserving gifts */
  H['claim-open'] = el => { S.claiming = el.dataset.id; S.chipping = null; renderGifts(); const i = app.querySelector('form[data-form="claim"] input[name="name"]'); if (i) i.focus(); };
  H['claim-cancel'] = () => { S.claiming = null; renderGifts(); };
  H['submit:claim'] = async (form, btn) => {
    const f = new FormData(form);
    const id = String(f.get('id')), name = String(f.get('name') || '').trim(), note = String(f.get('note') || '').trim();
    if (!name) return showError(form, `Add your name so ${S.r.host_name} knows who it's from.`);
    busy(btn, true, 'Reserving…');
    try {
      const res = await api.claimItem(id, name, note);
      store.set(KEY_NAME, name);
      S.claiming = null;
      if (res && res.ok) { const c = claims(); c[id] = res.claim_token; store.set(KEY_CLAIMS, c); toast("Reserved! It's yours to get."); }
      else toast('Someone just grabbed that one. Pick another?');
      await refresh();
    } catch (e) { busy(btn, false); showError(form, e.message); }
  };
  H['unclaim'] = async el => {
    const id = el.dataset.id, c = claims();
    if (!confirm('Give this gift back so someone else can pick it?')) return;
    try {
      await api.unclaimItem(id, c[id]);
      delete c[id]; store.set(KEY_CLAIMS, c);
      toast("Done — it's back on the list");
    } catch (e) { toast(e.message); }
    refresh();
  };

  /* paying: shagun fund ('fund') and chip-ins (item id) */
  const keyOf = el => el.dataset.key || (el.form && el.form.dataset.key) || '';
  const setPayLabel = key => {
    const b = app.querySelector(`[data-paygo="${key}"]`);
    const P = S.pays[key];
    if (b && P) b.textContent = P.amount > 0 ? `Pay ${inr(P.amount)} with UPI` : 'Pay with UPI';
  };
  H['chip-open'] = el => { S.chipping = el.dataset.id; S.claiming = null; delete S.pays[el.dataset.id]; renderGifts(); };
  H['chip-cancel'] = () => { S.chipping = null; renderGifts(); };
  H['amt'] = el => {
    const key = keyOf(el), P = payState(key);
    P.amount = Number(el.dataset.v); P.custom = false;
    el.closest('form').querySelectorAll('.amt').forEach(b => b.setAttribute('aria-pressed', String(b === el)));
    const c = el.closest('form').querySelector('input[name="custom"]'); if (c) c.value = '';
    setPayLabel(key);
  };
  H['input:custom'] = el => {
    const key = keyOf(el), P = payState(key);
    const v = Math.round(Number(el.value));
    if (el.value) { P.custom = true; P.amount = v > 0 ? v : 0; el.form.querySelectorAll('.amt').forEach(b => b.setAttribute('aria-pressed', 'false')); }
    setPayLabel(key);
  };
  H['input:pname'] = el => { payState(keyOf(el)).name = el.value; };
  H['input:pmsg'] = el => { payState(keyOf(el)).message = el.value; };
  H['submit:pay'] = form => {
    const key = form.dataset.key, P = payState(key);
    const f = new FormData(form);
    P.name = String(f.get('pname') || '').trim();
    P.message = String(f.get('pmsg') || '').trim();
    if (!(P.amount >= 1)) return showError(form, 'Pick an amount or type your own.');
    if (!P.name) return showError(form, `Add your name so ${S.r.host_name} knows who it's from.`);
    store.set(KEY_NAME, P.name);
    P.step = 'pay'; rerender(key);
    const it = key === 'fund' ? null : itemById(key);
    if (IS_MOBILE) location.href = upiLink(S.r, P.amount, it ? 'Gift: ' + it.name : 'Shagun: ' + S.r.title);
  };
  H['copy-upi'] = () => copyText(S.r.upi_id, 'UPI ID copied');
  H['pay-back'] = el => { payState(keyOf(el)).step = 'form'; rerender(keyOf(el)); };
  H['pay-again'] = el => {
    const key = keyOf(el);
    if (key === 'fund') { const P = payState(key); P.step = 'form'; P.message = ''; renderFund(); }
    else { S.chipping = null; delete S.pays[key]; renderGifts(); }
  };
  H['paid'] = async el => {
    const key = keyOf(el), P = payState(key);
    busy(el, true, 'Sending…');
    try {
      await api.addContribution(slug, P.name, P.amount, P.message, key === 'fund' ? null : key);
      P.step = 'done';
      await load(); rerender(key);
    } catch (e) { busy(el, false); toast(e.message); }
  };

  render();
}

/* ---------- messages ---------- */
function viewMessage(title, text, href, label) {
  document.title = title;
  app.innerHTML = `
    <div class="page-head" style="padding-top:60px">
      <h1>${esc(title)}</h1>
      <p class="muted" style="margin-top:10px;max-width:44ch">${esc(text)}</p>
      <div class="btn-row" style="margin-top:20px">
        ${href ? `<a class="btn" href="${esc(href)}">${esc(label)}</a>` : ''}
        <a class="btn ${href ? 'ghost' : ''}" href="#/">Go to Bash home</a>
      </div>
    </div>`;
}

route();
})();
</script>
</body>
</html>
