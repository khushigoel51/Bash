  try { document.execCommand('copy'); toast(done || 'Link copied'); } catch (e) { toast('Press and hold to copy'); }
  ta.remove();
}
function busy(btn, on, label) {
  if (!btn) return;
  if (on) { btn.dataset.label = btn.textContent; btn.textContent = label || 'Saving…'; btn.disabled = true; }
  else { btn.textContent = btn.dataset.label || btn.textContent; btn.disabled = false; }
}
function dateInfo(str) {
  if (!str) return null;
  const d = new Date(str + 'T00:00:00');
  if (isNaN(d)) return null;
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const days = Math.round((d - today) / 86400000);
  const pretty = d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
  let rel = '';
  if (days > 1) rel = 'in ' + days + ' days';
  else if (days === 1) rel = 'tomorrow';
  else if (days === 0) rel = "it's today";
  return { pretty, rel };
}
function upiLink(r, amount, note) {
  const p = new URLSearchParams({ pa: r.upi_id, pn: r.upi_name || r.host_name, am: String(amount), cu: 'INR', tn: note.slice(0, 50) });
  return 'upi://pay?' + p.toString().replace(/\+/g, '%20');
}
function qrSvg(text) {
  if (typeof window.qrcode !== 'function') return '';
  try { const q = window.qrcode(0, 'M'); q.addData(text); q.make(); return q.createSvgTag(4, 0); } catch (e) { return ''; }
}
