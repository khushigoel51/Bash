<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bash — gift registries and shagun funds</title>
<meta name="description" content="Set up a wishlist or a shagun fund, share one link, and let your people jump in. No sign-in required.">
<meta property="og:title" content="Bash — gifting with the volume turned up">
<meta property="og:description" content="Pick a gift or send shagun in seconds. No sign-in required.">
<meta name="theme-color" content="#E6007A">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎉</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --fuchsia:#E6007A;--tangerine:#FF7A29;--gold:#F2B705;--indigo:#1B1035;
  --cream:#FFF7F0;--ink:#1B1035;--muted:#6E5F80;--card:#FFFFFF;--field:#FFFFFF;
  --line:rgba(27,16,53,.12);--wash:#FFE9F3;--ok:#0E8A5F;--danger:#C2185B;
  --grad:linear-gradient(100deg,var(--fuchsia),var(--tangerine));
  --display:'Bricolage Grotesque',system-ui,-apple-system,'Segoe UI',sans-serif;
  --body:Inter,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--cream:#150C22;--ink:#F4EDFB;--muted:#B3A5C9;--card:#20152F;--field:#2A1D3B;--line:rgba(244,237,251,.14);--wash:#3A1530;--ok:#4FD1A0;--danger:#FF6FA8;color-scheme:dark}
}
:root[data-theme="dark"]{--cream:#150C22;--ink:#F4EDFB;--muted:#B3A5C9;--card:#20152F;--field:#2A1D3B;--line:rgba(244,237,251,.14);--wash:#3A1530;--ok:#4FD1A0;--danger:#FF6FA8;color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.5;min-height:100%;overflow-x:hidden;position:relative;-webkit-font-smoothing:antialiased}
img,svg{max-width:100%}
a{color:var(--fuchsia)}
[hidden]{display:none!important}
.blob{position:absolute;border-radius:50%;filter:blur(60px);opacity:.5;z-index:0;pointer-events:none}
.b1{width:420px;height:420px;background:var(--fuchsia);top:-160px;right:-160px}
.b2{width:340px;height:340px;background:var(--gold);top:240px;left:-180px;opacity:.35}
header.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px 22px 0;max-width:680px;margin:0 auto;position:relative;z-index:1}
.brand{font-family:var(--display);font-weight:800;font-size:1.4rem;letter-spacing:-.01em;color:var(--ink);text-decoration:none}
.brand span{color:var(--fuchsia)}
.wrap{max-width:680px;margin:0 auto;padding:0 22px;position:relative;z-index:1}
footer{padding:40px 22px 50px;text-align:center;color:var(--muted);font-size:.85rem;position:relative;z-index:1}

/* type */
.display{font-family:var(--display);font-weight:800;letter-spacing:-.02em}
h1,h2,h3{font-family:var(--display);margin:0}
.h2{font-size:1.45rem;font-weight:800;letter-spacing:-.01em;margin-bottom:6px}
.muted{color:var(--muted)}
.small{font-size:.86rem}
p{margin:0 0 12px}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--grad);color:#fff;border:none;padding:14px 24px;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;font-family:inherit;text-decoration:none;white-space:nowrap;min-height:48px}
.btn:hover{filter:brightness(1.06)}
.btn:disabled{opacity:.6;cursor:progress}
.btn.ghost{background:transparent;color:var(--ink);border:2px solid var(--line)}
.btn.ghost:hover{border-color:var(--fuchsia);filter:none}
.btn.sm{padding:9px 14px;font-size:.9rem;min-height:40px;border-radius:10px}
.btn.wa{background:#1FA855}
.btn.block{width:100%}
.link{background:none;border:none;padding:6px 2px;font:inherit;font-size:.88rem;font-weight:600;color:var(--muted);cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.link:hover{color:var(--ink)}
.link.danger:hover{color:var(--danger)}
:focus-visible{outline:2.5px solid var(--fuchsia);outline-offset:2px;border-radius:6px}
.btn-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}

/* hero */
.hero{padding:52px 0 8px}
.hero h1{font-size:clamp(2.4rem,9vw,3.3rem);line-height:1.04;margin:0 0 16px}
.hero h1 em{font-style:normal;color:var(--fuchsia)}
.lede{color:var(--muted);font-size:1.08rem;line-height:1.55;max-width:36ch;margin:0 0 28px}
.steps{display:flex;flex-direction:column;gap:16px;margin:48px 0 8px}
.step{display:flex;gap:14px;align-items:flex-start}
.step .n{font-family:var(--display);font-weight:800;font-size:1.3rem;color:var(--fuchsia);flex:none;width:34px}
.step p{margin:0;color:var(--muted)}
.step strong{color:var(--ink);display:block;margin-bottom:2px;font-family:var(--display)}

/* sections */
.section{margin-top:40px}
.panel{background:var(--card);border-radius:18px;padding:20px;border:1px solid var(--line)}
.page-head{padding:36px 0 4px}
.page-head h1{font-size:clamp(2rem,7vw,2.6rem);line-height:1.08}
.back{display:inline-block;margin-top:22px;font-size:.9rem;color:var(--muted);text-decoration:none;font-weight:600}
.back:hover{color:var(--ink)}

/* forms */
form{margin:0}
.field{display:block;margin:0 0 18px;border:0;padding:0;min-width:0}
.field>span,.field legend{display:block;font-weight:600;font-size:.95rem;margin-bottom:7px;padding:0}
.opt{font-style:normal;font-weight:400;color:var(--muted);font-size:.85rem;margin-left:4px}
.field small{display:block;color:var(--muted);font-size:.83rem;margin-top:6px}
input[type=text],input[type=url],input[type=number],input[type=date],input:not([type]),textarea{width:100%;padding:13px 15px;border-radius:12px;border:2px solid var(--line);background:var(--field);color:var(--ink);font:inherit;font-size:1rem}
textarea{resize:vertical;min-height:84px}
input:focus,textarea:focus{outline:none;border-color:var(--fuchsia)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
@media (max-width:520px){.grid2{grid-template-columns:1fr}}
.form-error{color:var(--danger);font-weight:600;font-size:.9rem;margin:0 0 14px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{position:relative}
.chip input{position:absolute;opacity:0;inset:0;cursor:pointer}
.chip span{display:inline-block;padding:9px 14px;border-radius:99px;border:2px solid var(--line);font-weight:600;font-size:.92rem;background:var(--field);cursor:pointer;user-select:none}
.chip input:checked+span{border-color:var(--fuchsia);background:var(--wash)}
.chip input:focus-visible+span{outline:2.5px solid var(--fuchsia);outline-offset:2px}
.switch{display:flex;gap:14px;align-items:flex-start;cursor:pointer}
.switch input{position:absolute;opacity:0;width:1px;height:1px}
.track{flex:none;width:46px;height:28px;border-radius:99px;background:var(--line);position:relative;transition:background .2s;margin-top:2px}
.track::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s}
.switch input:checked+.track{background:var(--fuchsia)}
.switch input:checked+.track::after{transform:translateX(18px)}
.switch input:focus-visible+.track{outline:2.5px solid var(--fuchsia);outline-offset:2px}
.switch small{display:block;color:var(--muted);font-size:.86rem}
.fund-fields{margin-top:18px;padding-left:60px}
@media (max-width:520px){.fund-fields{padding-left:0}}

/* your bashes */
.mine{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-direction:column;gap:10px}
.mine li{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.emo{font-size:1.5rem;line-height:1}
.grow{flex:1;min-width:0}
.grow strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--display)}

/* invite header (guest view) */
.invite{padding:34px 0 0}
.invite .emo-big{font-size:3rem;line-height:1;display:block;margin-bottom:14px}
.invite h1{font-size:clamp(2.5rem,10vw,3.6rem);line-height:1.02;letter-spacing:-.025em;font-weight:800;word-break:break-word}
.host{margin:12px 0 0;font-size:1.05rem;color:var(--muted)}
.host strong{color:var(--ink)}
.when{display:inline-flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:700;padding:6px 13px;border-radius:99px;background:var(--gold);color:var(--indigo)}
.pill.soft{background:var(--card);color:var(--ink);border:1px solid var(--line)}
.letter{margin-top:22px;background:var(--card);border-left:4px solid var(--fuchsia);border-radius:4px 14px 14px 4px;padding:16px 18px;white-space:pre-line;font-size:1.02rem}
.letter cite{display:block;margin-top:8px;font-style:normal;color:var(--muted);font-size:.9rem}

/* gifts */
.gifts{list-style:none;margin:16px 0 0;padding:0;background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden}
.gift{display:flex;gap:14px;padding:18px 18px;border-top:1px dashed var(--line);align-items:flex-start}
.gift:first-child{border-top:0}
.gift-main{flex:1;min-width:0}
.gift-name{font-family:var(--display);font-weight:700;font-size:1.12rem;line-height:1.25;word-break:break-word}
.gift-meta{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:4px;font-size:.9rem;color:var(--muted)}
.gift-meta .price{color:var(--ink);font-weight:700}
.gift-meta a{font-weight:600}
.gift-note{margin:8px 0 0;font-size:.92rem;color:var(--muted)}
.gift-side{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.gift.taken .gift-name{text-decoration:line-through;text-decoration-thickness:2px;text-decoration-color:var(--fuchsia);color:var(--muted)}
.gift.mine-claim{background:var(--wash)}
.tag{display:inline-block;font-size:.8rem;font-weight:700;padding:5px 11px;border-radius:99px;border:1.5px solid var(--line);color:var(--muted);white-space:nowrap}
.tag.yours{border-color:var(--fuchsia);color:var(--fuchsia);background:var(--card)}
.claimline{margin:8px 0 0;font-size:.9rem}
.claimline .tag{margin-right:6px}
.inline-form{margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
.inline-form .field{margin-bottom:12px}
.gift-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}
@media (max-width:520px){
  .gift{flex-direction:column;gap:10px}
  .gift-side{align-items:flex-start;flex-direction:row;flex-wrap:wrap}
  .gift-actions{justify-content:flex-start}
}
.empty{padding:26px 20px;text-align:center;color:var(--muted)}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap}

/* shagun */
.meter{margin:14px 0 6px}
.meter-bar{height:14px;border-radius:99px;background:var(--line);overflow:hidden}
.meter-fill{height:100%;background:var(--grad);border-radius:99px;transition:width .6s ease}
.meter-label{display:flex;justify-content:space-between;gap:10px;margin-top:8px;font-size:.92rem;flex-wrap:wrap}
.meter-label strong{font-family:var(--display);font-size:1.15rem}
.amounts{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.amt{padding:11px 16px;border-radius:12px;border:2px solid var(--line);background:var(--field);color:var(--ink);font:inherit;font-weight:700;cursor:pointer;min-height:46px}
.amt[aria-pressed="true"]{border-color:var(--fuchsia);background:var(--wash)}
.paybox{text-align:center}
.pay-amount{font-family:var(--display);font-weight:800;font-size:2.2rem;line-height:1.1;margin:4px 0 2px}
.qr{display:inline-block;background:#fff;padding:10px;border-radius:14px;margin:14px 0 6px;line-height:0}
.qr svg{width:200px;height:200px}
.upi-row{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:10px 0 18px}
.upi-row code{font-family:var(--body);font-weight:700;background:var(--field);border:1px solid var(--line);padding:8px 12px;border-radius:10px;word-break:break-all}
.divider{height:1px;background:var(--line);margin:20px 0}
.contribs{list-style:none;margin:14px 0 0;padding:0}
.contribs li{display:flex;gap:12px;justify-content:space-between;padding:12px 0;border-top:1px dashed var(--line)}
.contribs li:first-child{border-top:0}
.contribs .amt-v{font-weight:700;white-space:nowrap}
.thanks{text-align:center;padding:8px 0}
.thanks .big{font-size:2.6rem;line-height:1;display:block;margin-bottom:10px}

/* share */
.share-link{display:flex;gap:8px;margin:12px 0}
.share-link input{flex:1;min-width:0;font-size:.92rem}
.note-box{background:var(--wash);border-radius:14px;padding:14px 16px;margin-top:16px;font-size:.92rem}
.note-box strong{display:block;margin-bottom:2px}

.banner{background:var(--card);border:2px solid var(--gold);border-radius:16px;padding:16px 18px;margin-top:22px}
.banner h3{font-size:1.15rem;margin-bottom:4px}
.owner-bar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-top:18px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:.9rem}
.cta-own{margin-top:48px;text-align:center}
.cta-own p{color:var(--muted)}
.loading{padding:80px 0;text-align:center;color:var(--muted)}
.loading .dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--fuchsia);margin:0 4px;animation:bounce 1s infinite ease-in-out}
.loading .dot:nth-child(2){animation-delay:.15s;background:var(--tangerine)}
.loading .dot:nth-child(3){animation-delay:.3s;background:var(--gold)}
@keyframes bounce{0%,80%,100%{transform:scale(.6);opacity:.5}40%{transform:scale(1);opacity:1}}

.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--indigo);color:#fff;padding:12px 18px;border-radius:12px;font-weight:600;font-size:.95rem;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:50;max-width:calc(100% - 40px);text-align:center;box-shadow:0 8px 24px rgba(27,16,53,.3)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .toast{background:#F4EDFB;color:#1B1035}}
.toast.show{opacity:1;transform:translate(-50%,0)}


/* photos, chip-in, extras */
.gift-top{display:flex;gap:14px;flex:1;min-width:0;align-items:flex-start}
.thumb{flex:none;width:76px;height:76px;border-radius:12px;object-fit:cover;background:var(--line);display:block}
.mini-meter{height:8px;border-radius:99px;background:var(--line);overflow:hidden;margin-top:10px;max-width:300px}
.mini-meter>div{height:100%;background:var(--grad);border-radius:99px;transition:width .6s ease}
.fundline{margin:6px 0 0;font-size:.9rem;color:var(--muted)}
.fundline strong{color:var(--ink)}
.tag.done{border-color:var(--ok);color:var(--ok)}
.tag.group{border-color:var(--gold);color:var(--ink);background:var(--card)}
.photo-pick{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.photo-pick .ph{flex:none;width:76px;height:76px;border-radius:12px;border:2px dashed var(--line);display:flex;align-items:center;justify-content:center;font-size:1.5rem;overflow:hidden;background:var(--field);color:var(--muted)}
.photo-pick .ph img{width:100%;height:100%;object-fit:cover}
.file-btn{position:relative;overflow:hidden}
.file-btn input{position:absolute;inset:0;opacity:0;cursor:pointer;font-size:0}
.chip-list{list-style:none;margin:10px 0 0;padding:0;font-size:.88rem}
.chip-list li{display:flex;justify-content:space-between;gap:10px;padding:4px 0;color:var(--muted)}
.chip-list li strong{color:var(--ink);font-weight:600}
.plus-card{border:2px solid var(--fuchsia)}
.plus-list{margin:0 0 18px;padding-left:20px;color:var(--ink)}
.plus-list li{margin:4px 0}
.danger-zone{margin-top:48px;padding-top:20px;border-top:1px dashed var(--line)}
.recover{margin-top:28px}
.recover form{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.recover input{flex:1;min-width:200px}
.sub-switch{margin-top:6px}
@media (max-width:520px){.thumb,.photo-pick .ph{width:64px;height:64px}}

@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
