// Shrinks a photo to a light JPEG in the browser, then uploads it.
function shrinkImage(file, max) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      const s = Math.min(1, max / Math.max(img.naturalWidth, img.naturalHeight));
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(img.naturalWidth * s));
      c.height = Math.max(1, Math.round(img.naturalHeight * s));
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
      ctx.drawImage(img, 0, 0, c.width, c.height);
      URL.revokeObjectURL(url);
      c.toBlob(b => b ? resolve(b) : reject(new Error("Couldn't read that photo.")), 'image/jpeg', 0.82);
    };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error("That file doesn't look like a photo. Try a JPG or PNG.")); };
    img.src = url;
  });
}
async function uploadPhoto(file) {
  const blob = await shrinkImage(file, 1000);
  const path = uid().replace(/-/g, '') + '.jpg';
  let res;
  try {
    res = await fetch(BASE + '/storage/v1/object/gift-photos/' + path, {
      method: 'POST', body: blob,
      headers: authHeaders({ 'Content-Type': 'image/jpeg', 'cache-control': 'max-age=31536000', 'x-upsert': 'false' })
    });
  } catch (e) { throw new Error("Couldn't upload the photo. Check your connection."); }
  if (!res.ok) throw new Error("Couldn't upload that photo. Try a different one.");
  return BASE + '/storage/v1/object/public/gift-photos/' + path;
}

