<div class="blob b1"></div><div class="blob b2"></div>
<header class="top"><a class="brand" href="#/">Bash<span>.</span></a><nav id="nav"></nav></header>
<main class="wrap" id="app"><div class="loading"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div></main>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<footer>Bash · gifting that's actually fun to send</footer>

<script>
/* ============================================================
   SETTINGS — paste your Supabase details here to go live.
   Supabase → Project Settings → API:
     supabaseUrl  = "Project URL"   (https://xxxx.supabase.co)
     supabaseKey  = the "publishable" key (or the legacy "anon public" key)
   ============================================================ */
const CONFIG = {
  supabaseUrl: 'https://xqqegcvqcqfxtovyjivm.supabase.co',
  supabaseKey: 'sb_publishable_k_zYUbMOJSjMR4QSFafbeQ_XTukeAez'
};
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
<script>
(function () {
'use strict';

/* ---------- small helpers ---------- */
const app = document.getElementById('app');
const BASE = (CONFIG.supabaseUrl || '').replace(/\/+$/, '');
const OCCASIONS = {
  birthday: { label: 'Birthday', emoji: '🎂' },
  wedding: { label: 'Wedding', emoji: '💍' },
  baby: { label: 'Baby shower', emoji: '🍼' },
  housewarming: { label: 'Housewarming', emoji: '🏡' },
  anniversary: { label: 'Anniversary', emoji: '🥂' },
  other: { label: 'Something else', emoji: '🎉' }
};
const SHAGUN = [501, 1100, 2100, 5100];
const PLUS_PRICE = 149;
const UPI_RE = /^[a-zA-Z0-9.\-_]{2,256}@[a-zA-Z]{2,64}$/;
const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[a-zA-Z]{2,}$/;
const IS_MOBILE = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
const KEY_MINE = 'bash_mine', KEY_CLAIMS = 'bash_claims', KEY_NAME = 'bash_guest_name';

const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const enc = encodeURIComponent;
const inr = n => '₹' + Math.round(Number(n) || 0).toLocaleString('en-IN');
const occ = k => OCCASIONS[k] || OCCASIONS.other;
const safeUrl = u => /^https?:\/\//i.test(u || '') ? u : '';
const domain = u => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch (e) { return 'Link'; } };
const baseUrl = () => location.href.split('#')[0];
const guestUrl = slug => baseUrl() + '#/r/' + enc(slug);
const manageUrl = (slug, tok) => baseUrl() + '#/m/' + enc(slug) + '/' + enc(tok);
const uid = () => (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : 'id' + Date.now().toString(16) + Math.random().toString(16).slice(2);
const people = n => n + ' ' + (n === 1 ? 'person' : 'people');

const store = {
  get(k, d) { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { /* storage off: features degrade */ } }
};
function rememberBash(r, token) {
  const mine = store.get(KEY_MINE, []).filter(m => m.slug !== r.slug);
  mine.unshift({ slug: r.slug, token, title: r.title, occasion: r.occasion });
  store.set(KEY_MINE, mine.slice(0, 30));
}
const forgetBash = slug => store.set(KEY_MINE, store.get(KEY_MINE, []).filter(m => m.slug !== slug));
const myTokenFor = slug => (store.get(KEY_MINE, []).find(m => m.slug === slug) || {}).token;

let toastTimer;
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
}
async function copyText(text, done) {
  try { await navigator.clipboard.writeText(text); toast(done || 'Link copied'); return; } catch (e) { /* fall back */ }
  const ta = document.createElement('textarea');
  ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
